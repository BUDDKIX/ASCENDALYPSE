[gd_scene format=3]

[ext_resource type="Script" path="res://opening/encounter.gd" id="fight"]

[ext_resource type="SpriteFrames" path="res://opening/fight_frames.tres" id="clips"]

[ext_resource type="Texture2D" path="res://hud/face_on.png" id="face"]
