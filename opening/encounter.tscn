[ext_resource type="AudioStream" path="res://audio/enemy_death.wav" id="enemy_death_sfx"]

[sub_resource type="RectangleShape2D" id="nextfloor"]
size = Vector2(50,20)

[sub_resource type="RectangleShape2D" id="end"]
