[node name="DialogueLayer" type="CanvasLayer" parent="."]
layer = 10

[node name="Dialogue" type="PanelContainer" parent="DialogueLayer"]
visible = false
anchor_left = 0.0
anchor_top = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 24.0
offset_top = -146.0
offset_right = -24.0
offset_bottom = -20.0
mouse_filter = 2
